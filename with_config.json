{
  "_comment": "══════════════════════════════════════════════════════════════",
  "_comment2": " Rosetta Playground — With Platform 专用配置文件",
  "_comment3": " 所有 DBMS 部署在 AnyDev 容器 (21.6.101.185) 上",
  "_comment4": " With 容器通过 TCP 远程连接执行 SQL 并比对 diff",
  "_comment5": " 实测验证时间: 2026-06-04",
  "_comment6": "══════════════════════════════════════════════════════════════",
  "playground": {
    "traceless": true,
    "_note": "每次执行后自动清理临时数据库，不留痕迹"
  },
  "health_monitor": {
    "_comment": "定期扫描各DBMS健康状态，自动拉起挂掉的实例",
    "enabled": true,
    "interval_seconds": 30,
    "auto_restart": true,
    "max_retries": 3,
    "ssh_host": "21.6.101.185",
    "ssh_user": "root",
    "ssh_timeout": 10
  },
  "databases": [
    {
      "_comment": "──── ✅ 已验证: MySQL 9.6.0 ────",
      "name": "mysql-9.6",
      "type": "mysql",
      "host": "21.6.101.185",
      "port": 3306,
      "user": "root",
      "password": "",
      "driver": "pymysql",
      "skip_patterns": [],
      "init_sql": [
        "SET sql_mode='STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION'",
        "SET NAMES utf8mb4"
      ],
      "enabled": true,
      "restart": {
        "enabled": true,
        "service": "mysqld",
        "command": "pkill -9 mysqld; /usr/sbin/mysqld --user=mysql --daemonize"
      }
    },
    {
      "_comment": "──── ✅ 已验证: TXSQL 8.0.30 (Tencent MySQL fork) ────",
      "name": "txsql-8.0",
      "type": "mysql",
      "host": "21.6.101.185",
      "port": 3307,
      "user": "root",
      "password": "",
      "driver": "pymysql",
      "skip_patterns": [],
      "init_sql": [
        "SET sql_mode='STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION'",
        "SET NAMES utf8mb4"
      ],
      "enabled": true,
      "restart": {
        "enabled": true,
        "service": "txsql",
        "command": "/usr/local/mysql/bin/mysqld --user=root --port=3307 --socket=/tmp/mysql_txsql.sock --datadir=/usr/local/mysql/data --pid-file=/usr/local/mysql/data/mysqld.pid --daemonize"
      }
    },
    {
      "_comment": "──── ✅ 已验证: TiDB 8.5.6 ────",
