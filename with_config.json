{
  "_comment": "══════════════════════════════════════════════════════════════",
  "_comment2": " Rosetta Playground — 本地部署专用配置文件",
  "_comment3": " 服务直接运行在 21.6.101.185 上，DBMS 走 127.0.0.1 本地连接",
  "_comment4": " 健康检查/重启直接执行本地命令，无需 SSH",
  "_comment5": " 更新日期: 2026-06-11",
  "_comment6": "══════════════════════════════════════════════════════════════",
  "playground": {
    "traceless": true,
    "_note": "每次执行后自动清理临时数据库，不留痕迹"
  },
  "health_monitor": {
    "_comment": "定期扫描各DBMS健康状态，自动拉起挂掉的实例（本地执行）",
    "enabled": true,
    "interval_seconds": 60,
    "auto_restart": true,
    "max_retries": 3,
    "ssh_host": "127.0.0.1",
    "ssh_user": "root",
    "ssh_timeout": 10
  },
  "databases": [
    {
      "_comment": "──── ✅ 已验证: MySQL 9.6.0 ────",
      "name": "mysql-9.6",
      "type": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "",
      "driver": "pymysql",
      "skip_patterns": [],
      "init_sql": [
        "SET sql_mode='STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION'",
        "SET NAMES utf8mb4"
      ],
      "enabled": true,
      "restart": {
        "enabled": true,
        "service": "mysqld",
        "command": "pkill -9 mysqld 2>/dev/null; /usr/sbin/mysqld --user=mysql --daemonize"
      }
    },
    {
      "_comment": "──── ✅ 已验证: TXSQL 8.0.30 (Tencent MySQL fork) ────",
